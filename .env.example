# ─────────────────────────────────────────────
# UPI Finance Tracker – Environment Variables
# Copy this file to .env and fill in values.
# ─────────────────────────────────────────────

# ── MongoDB Atlas ────────────────────────────
# Full SRV connection string from Atlas dashboard
# Replace <username>, <password>, and <cluster> with your actual values
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/upi_tracker?retryWrites=true&w=majority&appName=<appName>"

# Name of the database (auto-created on first write)
MONGO_DB_NAME="upi_tracker"

# ── Redis ────────────────────────────────────
# Option A – Redis Cloud (recommended for production)
REDIS_URL="redis://default:<password>@<host>:<port>"

# Option B – Local Docker Redis (see docker-compose.yml)
# REDIS_URL="redis://localhost:6379"

# ── Google OAuth 2.0 ─────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="<your-google-client-id>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-<your-secret>"

# Callback URL registered in Google Console (must match exactly)
# For local dev: http://localhost:8000/auth/callback
GOOGLE_REDIRECT_URI="http://localhost:8000/auth/callback"

# ── JWT ──────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_ALGORITHM="HS256"
# Token lifetime in seconds (86400 = 24 hours)
JWT_EXPIRE_SECONDS=86400

# ── App ──────────────────────────────────────
APP_ENV="development"   # development | production
APP_HOST="0.0.0.0"
APP_PORT=8000
# Allowed CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
